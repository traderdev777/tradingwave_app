# TradingWave local configuration.
# `npm run setup` copies this to .env and fills SESSION_SECRET for you.

# SQLite file for local use (created at prisma/dev.db).
# To use Postgres later: set provider = "postgresql" in prisma/schema.prisma
# and DATABASE_URL="postgresql://user:pass@localhost:5432/tradingwave"
DATABASE_URL="file:./dev.db"

# Long random string used to sign session cookies. Never commit the real one.
SESSION_SECRET=""

# Optional: this email becomes ADMIN when it signs up or signs in.
# If empty, the very first account created becomes ADMIN.
ADMIN_EMAIL=""

# Optional: public URL of the app, used for the origin check behind a proxy.
APP_URL="http://localhost:3000"

# ---- Step 3: strategy builder ----
# Optional: Google Gemini API key (https://aistudio.google.com/apikey). Gemini only DRAFTS rules;
# it never places orders. Leave empty to use the built-in English rules engine.
GEMINI_API_KEY=""
# Model used for drafting. Any generateContent-capable Gemini model works.
GEMINI_MODEL="gemini-2.5-flash"

# Optional: override F&O lot sizes without a code change (verify with the exchange), e.g.
# LOT_SIZE_OVERRIDES="NIFTY=65,BANKNIFTY=30"
LOT_SIZE_OVERRIDES=""

# Optional: drafts allowed per user per 10 minutes (default 20).
COMPILE_RATE_LIMIT=""
