# TradingWave local configuration.
# `npm run setup` copies this to .env and fills SESSION_SECRET for you.

# SQLite file for local use (created at prisma/dev.db).
# To use Postgres later: set provider = "postgresql" in prisma/schema.prisma
# and DATABASE_URL="postgresql://user:pass@localhost:5432/tradingwave"
DATABASE_URL="file:./dev.db"

# Long random string used to sign session cookies. Never commit the real one.
SESSION_SECRET=""

# Optional: this email becomes ADMIN when it signs up or signs in.
# If empty, the very first account created becomes ADMIN.
ADMIN_EMAIL=""

# Optional: public URL of the app, used for the origin check behind a proxy.
APP_URL="http://localhost:3000"
